# Observability Platform — Variables d'environnement
# Copier vers .env et renseigner les valeurs avant docker compose up

# --- Microsoft Teams (webhook entrant) ---
# Canal Teams → Connecteurs → Incoming Webhook → copier l'URL
TEAMS_WEBHOOK_URL=https://xxxxx.webhook.office.com/webhookb2/xxxxx

# --- Jira Cloud (API REST v2) ---
# Créer un token : https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://ton-compte.atlassian.net
JIRA_EMAIL=ton.email@exemple.com
JIRA_API_TOKEN=ton-api-token
JIRA_PROJECT_KEY=OBS
